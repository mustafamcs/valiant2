runtime/client/game/upload/
runtime/client/game/syserr/
runtime/client/game/bin/syserr/
runtime/client/game/GPUCache/
runtime/client/game/screenshot/

# ── Server runtime (generated by sync-config / game.exe) ─
runtime/server/.state/
runtime/server/**/syserr*
runtime/server/**/syslog*
