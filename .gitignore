# ── Secrets & Environment ─────────────────────────────────
.env

# ── IDE / Editor ──────────────────────────────────────────
.vs/
**/.vs/
**/*.suo
**/*.user
.DS_Store
Thumbs.db

# ── Build artifacts ───────────────────────────────────────
# Only ignore Debug/Release/x86 under source/ and tools/ (build output).
# Do NOT use **/Debug/ — it also blocks boost/preprocessor/debug/
# and web/adminpanel/system/Debug/ (CodeIgniter) on case-insensitive Windows.
source/**/Debug/
source/**/Release/
tools/**/Debug/
tools/**/Release/
**/Distribute/
**/OBJDIR/
source/**/x64/
source/**/x86/
tools/**/x64/
tools/**/x86/
artifacts/
**/*.obj
**/*.pch
**/*.pdb
**/*.ilk
**/*.exp
**/*.map
**/*.bsc
**/*.tlog
**/*.lastbuildstate
**/*.recipe
**/*.VC.db
**/*.VC.VC.opendb
**/*.pyc
**/__pycache__/
tools/client-config/obj/
tools/client-launcher/obj/
tools/control-center/obj/
ekran-goruntuleri/

# ── Build output libraries ────────────────────────────────
source/client/external/lib/rootlib.lib
source/client/external/lib/uiscriptlib.lib
source/server/source/libs/libgame/lib/*.lib
source/server/source/libs/liblua/5.0/lib/*.lib
source/server/source/libs/libpoly/*.lib
source/server/source/libs/libsql/*.lib
source/server/source/libs/libthecore/lib/*.lib

# ── Build output binaries (compiled by build-all) ────────
runtime/client/VALIANT2.exe
runtime/client/game/bin/M2Client.exe
runtime/client/game/bin/config.exe
runtime/client/game/pack/
runtime/server/main/srv1/share/bin/db.exe
runtime/server/main/srv1/share/bin/game.exe
runtime/server/main/srv1/share/locale/europe/quest/qc.exe

