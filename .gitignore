runtime/server/**/packet_info.txt
runtime/server/**/p2p_packet_info.txt
runtime/server/**/profile.txt
runtime/server/**/stdout.txt
runtime/server/**/usage.txt

# ── Server junction directories (sync-config.ps1) ────────
runtime/server/main/srv1/auth/data/
runtime/server/main/srv1/auth/locale/
runtime/server/main/srv1/auth/log/
runtime/server/main/srv1/chan/**/data/
runtime/server/main/srv1/chan/**/locale/
runtime/server/main/srv1/chan/**/log/
runtime/server/main/srv1/db/log/
runtime/server/main/srv1/share/locale/turkey/

# ── Downloaded dependencies (setup.ps1 installs these) ───
runtime/dependencies/
runtime/patchserver/

